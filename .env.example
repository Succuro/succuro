# Postgres. A workspace's credentials are stored per workspace, sealed, never here.
SUCCURO_DATABASE_URL=postgres://user:password@localhost:5432/succuro
# The direct address, for migrations, when SUCCURO_DATABASE_URL goes through a pooler that refuses session settings. Optional.
SUCCURO_DATABASE_URL_UNPOOLED=
# openssl rand -base64 32. Signs sessions and requesters' links: changing it signs everyone out and ends the links already sent.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Who may sign up and start workspaces, comma-separated. Anyone else needs an invitation, and can only join.
SUCCURO_ADMINS=
# openssl rand -base64 32: seals every connection's credentials. Keep it safe: without it they can't be opened.
SUCCURO_SECRETS_KEY=
# Addresses and passwords, unless a company's provider is set. Needs RESEND_API_KEY: a mailed link proves each address.
SUCCURO_PASSWORD_SIGN_IN=false
# A company's own identity provider (any OpenID Connect server). When set, members sign in there and nowhere else.
# Redirect address to register with it: <BETTER_AUTH_URL>/api/auth/callback/oidc
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Its name on the sign-in page.
OIDC_NAME=
# Google's OAuth app, for signing in unless a company's provider is set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The instance's own mail to its members (sign-in links, invitations, notifications), through Resend. Replies to customers go through each workspace's own connection, never this key.
RESEND_API_KEY=
SUCCURO_MAIL_FROM=Succuro <no-reply@example.com>
# What the hourly job at /api/cron/stuck-replies must be called with, as a bearer.
CRON_SECRET=
